{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/IcaroSilvaFK/motogp-launcher/main/catalog/catalog.schema.json",
  "title": "MotoGP Launcher mod catalog",
  "description": "Static catalog of mods listed by the launcher. Add an entry by pull request.",
  "type": "object",
  "required": ["schemaVersion", "entries"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "httpsUrl": {
      "type": "string",
      "pattern": "^https://[^\\s@/]+(/\\S*)?$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "download": {
      "type": "object",
      "description": "Present only when the author allows redistribution.",
      "required": ["url", "size", "sha256"],
      "additionalProperties": false,
      "properties": {
        "url": { "$ref": "#/$defs/httpsUrl" },
        "size": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "entry": {
      "type": "object",
      "required": ["id", "title", "author", "game", "category", "description", "version", "updatedAt", "pageUrl"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "title": { "$ref": "#/$defs/text" },
        "author": { "$ref": "#/$defs/text" },
        "game": { "$ref": "#/$defs/text" },
        "category": { "$ref": "#/$defs/text" },
        "description": { "$ref": "#/$defs/text" },
        "version": { "$ref": "#/$defs/text" },
        "updatedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "pageUrl": { "$ref": "#/$defs/httpsUrl" },
        "thumbnailUrl": { "$ref": "#/$defs/httpsUrl" },
        "screenshots": {
          "type": "array",
          "items": { "$ref": "#/$defs/httpsUrl" },
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true
        },
        "longDescription": { "$ref": "#/$defs/text", "maxLength": 20000 },
        "download": { "$ref": "#/$defs/download" }
      }
    }
  }
}
