# Copy to .env (git-ignored) for local runs, or to /etc/motogp-community.env (mode 0600) on the server.
# Placeholder values only: never commit real secrets.
DISCORD_CLIENT_ID=your-discord-application-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
PUBLIC_BASE_URL=https://community.example.com
DATABASE_URL=sqlite:///var/lib/motogp-community/community.db
# Comma-separated Discord user ids that act as moderators/admins.
ADMIN_DISCORD_IDS=123456789012345678
# Optional (defaults shown):
# BIND_ADDR=127.0.0.1:8787
# TRUST_PROXY_HEADERS=false
# DISCORD_API_BASE=https://discord.com/api/v10

# Mod hosting. MOD_STORAGE_DIR is required (it gets incoming/, pending/ and public/ subfolders).
MOD_STORAGE_DIR=/var/lib/motogp-community/mods
# Optional (defaults shown): 2 GiB per file, 10 GiB per user, 10 uploads started per user per day.
# MOD_MAX_UPLOAD_BYTES=2147483648
# MOD_USER_QUOTA_BYTES=10737418240
# MOD_UPLOADS_PER_DAY=10
